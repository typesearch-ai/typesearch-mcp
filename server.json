{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "ai.typesearch/news",
  "title": "typesearch",
  "description": "News search for AI agents: recent news on any topic from outlets worldwide, by country and language.",
  "version": "1.0.0",
  "websiteUrl": "https://typesearch.ai/mcp",
  "repository": {
    "url": "https://github.com/typesearch-ai/typesearch-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://api.typesearch.ai/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your typesearch API key, as a bearer token. Get one at https://app.typesearch.ai/api-keys",
          "value": "Bearer {typesearch_api_key}",
          "isRequired": true,
          "isSecret": true,
          "variables": {
            "typesearch_api_key": {
              "description": "typesearch API key (ts_live_…)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "typesearch-mcp",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "TYPESEARCH_API_KEY",
          "description": "Your typesearch API key (ts_live_…). Get one at https://app.typesearch.ai/api-keys",
          "isRequired": true,
          "isSecret": true
        }
      ]
    }
  ]
}
